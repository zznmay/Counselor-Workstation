# ===== 环境变量示例（复制为 .env 或直接以系统环境变量方式提供）=====
# 说明：服务端不自动加载 .env 文件，需通过启动环境注入（shell / pm2 / NSSM / 任务计划 / 云平台环境变量）。
#       未设置时使用下方默认值，均可安全运行。

# 服务监听端口（默认 8443，HTTPS；云平台反向代理场景由平台注入，通常为 3000）
PORT=8443

# JWT 登录密钥：留空则首次启动自动生成随机密钥并保存到 server/data/jwt.secret（推荐）。
# 如需多进程共享会话，可显式设置任意足够长的随机字符串。
# JWT_SECRET=

# ===== 种子数据模式（仅首次建库时生效；库已非空则完全不读取）=====
# demo  （默认）写入完整示例数据：8 个示例辅导员账号（初始密码 Hzky@123456）+ 24 名示例学生
#        及其谈话/预警/通知/待办/审批/模板/心理健康关注标记。仅用于本地开发与功能演示。
# empty 生产模式：仅创建管理员 admin 一个账号，不写入任何示例账号与示例业务数据；
#        其余账号、学生与业务数据一律由管理员登录后台按真实情况录入。
# 取值缺省或非 empty 时一律按 demo 处理。
WORKBENCH_SEED=demo

# ===== 管理员初始账号（仅 empty 模式有意义）=====
# 用户名固定为 admin，初始密码 Admin@2026（定义见 server/lib/db.js 的 seed()），
# 首次登录强制改密。如需自定义初始密码，改 db.js 中 seed() 的 admin 插入语句后重新建库。

# ===== 以下为进阶项，通常无需设置 =====
# 数据目录：默认 server/data；WORKBENCH_DATA_DIR 可指向外部目录（备份盘、测试隔离库等）
# WORKBENCH_DATA_DIR=

# 强制 HTTP（TLS 由反向代理/云平台边缘终止）：0 = HTTP；缺省 = HTTPS + 自签证书
# ENABLE_HTTPS=0

# ⚠️ 危险开关，仅用于数据不可用/密码彻底遗忘的恢复：
#    置 1 会在启动时直接删除整个数据目录并按种子重新初始化，日常启动切勿携带。
# RESET_DB=1