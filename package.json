{
  "name": "hangzhou-counselor-workbench",
  "private": true,
  "version": "1.0.0",
  "description": "知行辅导员工作台 —— 高校辅导员学生日常管理系统",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start:cloud": "npm run build:web && node --experimental-sqlite server/start-cloud.js",
    "start:cloud:prod": "npm run build:web && WORKBENCH_SEED=empty node --experimental-sqlite server/start-cloud.js",
    "verify:import": "node scripts/run-ts-script.cjs scripts/verify-import.ts",
    "verify:import:fields": "node scripts/run-ts-script.cjs scripts/verify-import-fields.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "antd": "^5.21.0",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
